{
  "$schema": "https://nitro.margelo.com/nitro.schema.json",
  "cxxNamespace": [
    "nitropalette"
  ],
  "ios": {
    "iosModuleName": "NitroPalette"
  },
  "android": {
    "androidNamespace": [
      "nitropalette"
    ],
    "androidCxxLibName": "NitroPalette"
  },
  "autolinking": {
    "NitroPalette": {
      "all": {
        "language": "c++",
        "implementationClassName": "NitroPalette"
      }
    }
  },
  "ignorePaths": [
    "node_modules"
  ]
}